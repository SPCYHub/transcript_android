# OPENAI_API_KEY: Optional build-time OpenAI fallback only.
# Leave this placeholder as-is for sideloaded / debug APKs.
# In the app, open Settings → Keys and paste your own Gemini and/or OpenAI key.
# User-entered keys are stored in the hardware-backed Android Keystore and take priority.
# Do not put real keys in this file or in the repository.
OPENAI_API_KEY=MY_OPENAI_API_KEY
